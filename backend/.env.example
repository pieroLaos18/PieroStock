# Backend Environment Variables
PORT=5000
BACKEND_URL=http://localhost:5000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sales_system_demo
DB_USER=root
DB_PASSWORD=

# JWT Configuration
JWT_SECRET=replace_with_at_least_64_random_characters
JWT_EXPIRES_IN=24h

# Email para verificación y recuperación de cuenta (Gmail App Password)
EMAIL_USER=
EMAIL_PASS=

# File Upload Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# CORS Configuration
FRONTEND_URL=http://localhost:5174
